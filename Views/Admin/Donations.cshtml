@model List<Donation>
@{ ViewData["Title"] = "Donations"; }
<h1 class="h3 mb-3">Donations</h1>
<partial name="_AdminNav" />
<div class="card-surface p-0 table-responsive">
<table class="table align-middle mb-0">
    <thead><tr><th>Date</th><th>Donor</th><th>Type</th><th>Details</th><th>Frequency</th><th class="text-end">Amount</th></tr></thead>
    <tbody>
    @foreach (var d in Model)
    {
        <tr>
            <td>@d.FormattedDate</td>
            <td>@(d.User?.FullName ?? "Anonymous")</td>
            <td>@(d.DonationType == "money" ? "💰 Money" : "🥕 Food")</td>
            <td>@d.FoodDescription</td>
            <td>@d.Frequency</td>
            <td class="text-end">@d.FormattedAmount</td>
        </tr>
    }
    @if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">No donations yet.</td></tr> }
    </tbody>
</table>
</div>
