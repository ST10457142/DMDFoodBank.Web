@model List<Beneficiary>
@{ ViewData["Title"] = "Beneficiaries"; }
<h1 class="h3 mb-3">Beneficiaries</h1>
<partial name="_AdminNav" />
<div class="card-surface p-0 table-responsive">
<table class="table align-middle mb-0">
    <thead><tr><th>Name</th><th>Phone</th><th>Household</th><th>Nearest hub</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var b in Model)
    {
        <tr>
            <td>@b.FullName</td><td>@b.Phone</td><td>@b.HouseholdSize</td><td>@b.NearestHub</td>
            <td><span class="badge @(b.Status == "approved" ? "bg-success" : b.Status == "rejected" ? "bg-secondary" : "bg-warning text-dark")">@b.Status</span></td>
            <td class="text-end">
                @if (b.Status == "pending")
                {
                    <form asp-action="BeneficiaryStatus" asp-route-id="@b.Id" method="post" class="d-inline"><input type="hidden" name="status" value="approved" /><button class="btn btn-sm btn-success">Approve</button></form>
                    <form asp-action="BeneficiaryStatus" asp-route-id="@b.Id" method="post" class="d-inline"><input type="hidden" name="status" value="rejected" /><button class="btn btn-sm btn-outline-danger">Reject</button></form>
                }
            </td>
        </tr>
    }
    @if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">No applications yet.</td></tr> }
    </tbody>
</table>
</div>
