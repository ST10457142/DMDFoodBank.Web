@model List<User>
@{ ViewData["Title"] = "All Users"; }
<h1 class="h3 mb-3">All Users</h1>
<partial name="_AdminNav" />
<div class="card-surface p-0 table-responsive">
<table class="table align-middle mb-0">
    <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Last sign-in</th><th></th></tr></thead>
    <tbody>
    @foreach (var u in Model)
    {
        <tr>
            <td>@u.FullName</td><td>@u.Email</td>
            <td><span class="badge @(u.Role == "admin" ? "bg-dark" : "bg-secondary")">@u.Role</span></td>
            <td>@(u.IsActive ? "Active" : "Inactive")</td>
            <td>@(u.LastLogin?.ToLocalTime().ToString("dd MMM yyyy HH:mm") ?? "—")</td>
            <td class="text-end">
                <form asp-action="ToggleActive" asp-route-id="@u.Id" method="post" class="d-inline">
                    <button class="btn btn-sm @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")">@(u.IsActive ? "Deactivate" : "Activate")</button>
                </form>
                <form asp-action="SetRole" asp-route-id="@u.Id" method="post" class="d-inline">
                    <input type="hidden" name="role" value="@(u.Role == "admin" ? "donor" : "admin")" />
                    <button class="btn btn-sm btn-outline-secondary">@(u.Role == "admin" ? "– Admin" : "+ Admin")</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
