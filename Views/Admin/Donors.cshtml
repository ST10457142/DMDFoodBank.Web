@model List<User>
@{ ViewData["Title"] = "Donors"; }
<h1 class="h3 mb-3">Donors</h1>
<partial name="_AdminNav" />

<form method="get" class="mb-3">
    <input name="q" value="@ViewBag.Query" class="form-control" placeholder="Search donors by name or email…" />
</form>

<div class="card-surface p-0 table-responsive">
<table class="table align-middle mb-0">
    <thead><tr><th>Name</th><th>Email</th><th>Type</th><th class="text-end">Total</th><th class="text-end">Donations</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var u in Model)
    {
        <tr>
            <td>@u.FullName</td><td>@u.Email</td><td>@u.DonorType</td>
            <td class="text-end">@u.FormattedTotal</td><td class="text-end">@u.DonationCount</td>
            <td>@(u.IsActive ? "Active" : "Inactive")</td>
            <td class="text-end">
                <form asp-action="ToggleActive" asp-route-id="@u.Id" asp-route-returnTo="donors" method="post">
                    <button class="btn btn-sm @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")">@(u.IsActive ? "Deactivate" : "Activate")</button>
                </form>
            </td>
        </tr>
    }
    @if (!Model.Any()) { <tr><td colspan="7" class="text-center text-muted py-4">No donors found.</td></tr> }
    </tbody>
</table>
</div>
