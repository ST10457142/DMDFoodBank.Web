@{
    string Active(string action) =>
        string.Equals((string?)ViewContext.RouteData.Values["action"], action, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    int unread = ViewBag.Unread ?? 0, pendB = ViewBag.PendingBeneficiaries ?? 0, pendV = ViewBag.PendingVolunteers ?? 0;
}
<ul class="nav nav-pills admin-nav mb-4 flex-wrap">
    <li class="nav-item"><a class="nav-link @Active("Index")" asp-controller="Admin" asp-action="Index">Dashboard</a></li>
    <li class="nav-item"><a class="nav-link @Active("Donors")" asp-controller="Admin" asp-action="Donors">Donors</a></li>
    <li class="nav-item"><a class="nav-link @Active("Donations")" asp-controller="Admin" asp-action="Donations">Donations</a></li>
    <li class="nav-item"><a class="nav-link @Active("Beneficiaries")" asp-controller="Admin" asp-action="Beneficiaries">Beneficiaries @if (pendB > 0) {<span class="badge bg-danger">@pendB</span>}</a></li>
    <li class="nav-item"><a class="nav-link @Active("Volunteers")" asp-controller="Admin" asp-action="Volunteers">Volunteers @if (pendV > 0) {<span class="badge bg-danger">@pendV</span>}</a></li>
    <li class="nav-item"><a class="nav-link @(Active("Messages") + Active("Message"))" asp-controller="Admin" asp-action="Messages">Messages @if (unread > 0) {<span class="badge bg-danger">@unread</span>}</a></li>
    <li class="nav-item"><a class="nav-link @Active("Users")" asp-controller="Admin" asp-action="Users">All Users</a></li>
</ul>
