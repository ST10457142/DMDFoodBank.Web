@{ ViewData["Title"] = "About"; }
<section class="hero text-white">
    <h1>Our Story</h1>
    <p class="lead">Born from a belief that no South African should go to bed hungry.</p>
</section>

<div class="row g-3 my-4 text-center">
    <div class="col-4"><div class="stat-tile"><div class="stat-num">6</div>Years</div></div>
    <div class="col-4"><div class="stat-tile"><div class="stat-num">7</div>Hubs</div></div>
    <div class="col-4"><div class="stat-tile"><div class="stat-num">48K+</div>Meals</div></div>
</div>

<section class="card-surface p-4 mb-4">
    <h2 class="h4">Who we are</h2>
    <p class="text-muted fst-italic">Fighting hunger since 2020</p>
    <p>DMD Food Bank was founded in response to the food crisis amplified by the COVID-19 pandemic. What started as a neighbourhood initiative in Soweto quickly grew into a multi-hub organisation serving thousands of families across Gauteng.</p>
    <p>We partner with supermarkets, restaurants, farms, and generous donors to rescue surplus food and distribute it to those who need it most — with dignity and respect.</p>
    <p class="mb-0">We are a registered NPO (123-456) and PBO (930 012 345), and all monetary donations qualify for Section 18A tax deductions.</p>
</section>

<h2 class="h4">Our Values</h2>
<div class="row g-3">
    <div class="col-md-4"><div class="card-surface p-4 h-100"><div class="fs-2">🌱</div><h3 class="h5">Dignity</h3><p class="mb-0">Every person deserves to receive food with respect and without stigma.</p></div></div>
    <div class="col-md-4"><div class="card-surface p-4 h-100"><div class="fs-2">🤝</div><h3 class="h5">Community</h3><p class="mb-0">We believe communities are stronger when they lift each other up.</p></div></div>
    <div class="col-md-4"><div class="card-surface p-4 h-100"><div class="fs-2">♻️</div><h3 class="h5">Sustainability</h3><p class="mb-0">Rescuing food waste and reducing environmental impact is at our core.</p></div></div>
</div>
